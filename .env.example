# Default: local deterministic workflow, no model requests or API cost.
AGENT_PROVIDER=mock
# Optional: only used when AGENT_PROVIDER=openai is explicitly selected.
# Server-only credentials. Never use a VITE_ prefix for the API key.
OPENAI_API_KEY=
# Select a model available to your account that supports Responses function calling.
OPENAI_MODEL=
AGENT_PORT=8787
# Cloud Run uses its attached service account, with no API key.
# AGENT_PROVIDER=gemini
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-2.5-flash-lite
# CASE_STORAGE=firestore
# SERVE_STATIC=true
# DEMO_CREDENTIALS=
